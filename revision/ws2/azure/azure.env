# Environment for scripts/orbit_v2.sh and the experiments on orbit-d (ORBIT_ENV=this file).
STATE=/opt/orbit-state
VENV=/opt/orbit-venv
FAB=/opt/fabric
export FABRIC_TEST_NETWORK=/opt/orbit-net
export FABRIC_ORDERER=orderer.example.com:7050
export FABRIC_ORDERER_HOST=orderer.example.com
export FABRIC_PEER1_ADDR=peer0.org1.example.com:7051
export FABRIC_PEER2_ADDR=peer0.org2.example.com:9051
export GANACHE_URL=http://10.10.1.5:8545
export GANACHE_HOST=10.10.1.5
# run_digest: Fabric containers are on these hosts; shaping/clock from all four
export ORBIT_DOCKER_HOSTS=orbit-a,orbit-b,orbit-c
export ORBIT_NET_HOSTS=orbit-a,orbit-b,orbit-c,local
export ORBIT_TOPOLOGY=multi_vm
