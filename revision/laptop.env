# Environment for running the WS3/WS5 harnesses against the laptop (WSL) v2 stack.
# Development/testing only: v2 results come from the Azure testbed (revision/ws2/azure/azure.env).
export OUTBOX_DB=/root/orbit-state/v2/outbox.db
export GANACHE_URL=http://127.0.0.1:8545
export FABRIC_BIN=/root/fabric-clean/bin FABRIC_CFG_PATH=/root/fabric-clean/config
export FABRIC_TEST_NETWORK=/root/fabric-clean/test-network
export FABRIC_PEER2_ADDR=localhost:9051
export PRIVACY_FILTER_URL=http://127.0.0.1:5011/filter_data
