# Application-server profiles for v2 (revision WS1). Read by scripts/orbit_v2.sh.
# Every value here is echoed by /health and therefore lands in the run digest.
#
#   dev   Werkzeug, as in v1: the orchestrator via socketio.run(debug=False),
#         the policy service via app.run(threaded=True).
#   prod  gunicorn with the gthread worker.
#
# The orchestrator runs ONE gunicorn worker process. Its idempotency slots
# (acquire/complete, with condition variables) and the TwinManager are
# process-local, so two workers would let concurrent duplicates reach Fabric
# twice (AUDIT_WS0 F6). Concurrency comes from threads; the request path is
# dominated by waits on the peer CLI subprocess and HTTP, which release the GIL.
# The policy service is stateless and can run several workers.

ORCH_PROD_WORKERS=1
ORCH_PROD_THREADS=64      # >= 2x the largest concurrency level in the sweep (32)
POLICY_PROD_WORKERS=2
POLICY_PROD_THREADS=32
GUNICORN_TIMEOUT=120      # s; worker is recycled if a request blocks longer
GUNICORN_KEEPALIVE=5      # s; the exp1 client uses keep-alive sessions
